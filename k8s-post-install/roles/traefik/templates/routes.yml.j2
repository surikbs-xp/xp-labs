http:
  routers:
    myapp:
      rule: "HostRegexp(`{subdomain:[a-z]+}.apps.surikbs.dev`)"
      service: k8s-workers-service
      entryPoints:
        - websecure
      tls:
        certResolver: myresolver

    k8s-api:
      rule: "Host(`k8s-api.surikbs.dev`)"
      service: k8s-api-service
      entryPoints:
        - websecure
      tls:
        certResolver: myresolver

  services:
    k8s-workers-service:
      loadBalancer:
        servers:
          - url: "https://10.0.1.20"
          - url: "https://10.0.1.21"
          - url: "https://10.0.1.22"
        passHostHeader: true

    k8s-api-service:
      loadBalancer:
        servers:
          - url: "https://10.0.1.10:6443"
        passHostHeader: true
