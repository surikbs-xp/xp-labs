# Global settings
global:
  checkNewVersion: false
  sendAnonymousUsage: false

# Define entry points
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https

  websecure:
    address: ":443"
    http:
      tls:
        certResolver: myresolver

# Enable API & Dashboard
api:
  dashboard: true
  insecure: false  # Change to true if testing

# ACME (Let's Encrypt) Configuration
certificatesResolvers:
  myresolver:
    acme:
      email: "your-email@example.com"
      storage: "/etc/traefik/acme.json"
      httpChallenge:
        entryPoint: web

# Ignore remote host certificates (use with caution)
serversTransport:
  insecureSkipVerify: true

# Enable providers (Merge `file` and `docker` under one `providers` key)
providers:
  file:
    directory: "/etc/traefik/"
    watch: true

  docker:
    exposedByDefault: false
